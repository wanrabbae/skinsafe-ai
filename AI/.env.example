AI_SERVICE_TOKEN=replace-me
AI_ENGINE_VERSION=0.3.0
AI_RULESET_VERSION=2026.07.2

# Verifikasi & pencarian BPOM live. cekbpom.pom.go.id diproteksi Cloudflare/
# reCAPTCHA sehingga panggilan langsung sering diblokir; arahkan ke proxy
# indonesia-civic-stack yang mengembalikan JSON {found, status, result...}.
# Service AI ini pakai port 8000, jadi jalankan civic-stack di port lain:
#   pip install "indonesia-civic-stack[api]" && civic-stack api --port 8010
# Kosongkan untuk best-effort langsung ke BPOM_BASE_URL (mudah gagal/unchecked).
# BPOM_VERIFY_URL=http://localhost:8010/bpom/check/{number}
# BPOM_SEARCH_URL=http://localhost:8010/bpom/search?q={query}
# BPOM_BASE_URL=https://cekbpom.pom.go.id
# BPOM_TIMEOUT=5

# Enrichment sidecar BPOM untuk recommender (training/enrich_bpom_status.py).
# Sumber apiindonesia — sama seperti BFF Apps. Isi bpomTrust 25% di rekomendasi.
# API_INDONESIA_API_BPOM_URL="https://use.apiindonesia.id/api/v1/bpom?q="
# API_INDONESIA_API_KEY=replace-me
