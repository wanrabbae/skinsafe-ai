generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  brand          String?
  imageUrl       String?
  ingredients    String?
  bpomNumber     String?
  bpomStatus     String?
  bpomRegistrant String?
  sourceUrl      String?
  createdAt      DateTime @default(now())
}
